# Anthropic API（必須）
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gemini API
GEMINI_API_KEY=your-gemini-key-here
# Phase 1 LLM プロバイダー: claude / gemini / both（デフォルト: both）
PHASE1_PROVIDER=both
# Database
# ローカル直接実行時（ホストからDockerのPostgresへ）
DATABASE_URL=postgresql+psycopg://gradmatch:gradmatch_dev@localhost:5433/gradmatch
# ※ Docker Compose内ではdocker-compose.ymlが自動的に上書きするため変更不要

# GitHub API トークン（オプション）
# 未設定: 60req/h（50社分析中に制限到達）
# 設定済み: 5000req/h（50社を制限なく分析可能）
# 取得: https://github.com/settings/tokens → Generate new token → 権限不要（public repos読み取りのみ）
# GITHUB_TOKEN=ghp_your-personal-access-token-here

# 法人番号API（承認後に設定、現在はコメントアウト）
# HOUJIN_API_ID=

# ログレベル
LOG_LEVEL=INFO