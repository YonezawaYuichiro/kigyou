# Anthropic API（必須）
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gemini API
GEMINI_API_KEY=your-gemini-key-here
# Phase 1 LLM プロバイダー: claude / gemini / both（デフォルト: both）
PHASE1_PROVIDER=both
# Database
# ローカル直接実行時（ホストからDockerのPostgresへ）
DATABASE_URL=postgresql+psycopg://gradmatch:gradmatch_dev@localhost:5433/gradmatch
# ※ Docker Compose内ではdocker-compose.ymlが自動的に上書きするため変更不要

# 法人番号API（承認後に設定、現在はコメントアウト）
# HOUJIN_API_ID=

# ログレベル
LOG_LEVEL=INFO