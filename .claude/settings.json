{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(python -m backend.*)",
      "Bash(python -m pytest*)",
      "Bash(pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(mypy*)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(pip freeze*)",
      "Bash(pip show*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(uvicorn*)",
      "Bash(echo*)",
      "Bash(cat*)",
      "Bash(ls*)",
      "Bash(dir*)",
      "Bash(type*)",
      "Bash(mkdir*)",
      "Bash(cd*)",
      "Bash(python --version*)",
      "Bash(pip --version*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(del /s*)",
      "Bash(rmdir /s*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Read(.env)",
      "Write(.env)",
      "Edit(.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruff format ${CLAUDE_FILE_PATHS} 2>nul & exit 0"
          }
        ]
      }
    ]
  }
}
